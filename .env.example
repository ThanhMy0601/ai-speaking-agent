# LiveKit — must match ai-speaking-api/.env and livekit.yaml
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Rails: the bare origin, NOT the /api/v1 base. The agent talks to
# /internal/* endpoints, which sit outside the public API namespace, and it
# builds the full path itself. Pointing this at :3000 (the Vite dev server)
# or appending /api/v1 makes every context fetch fail — and because the
# agent falls back to a generic conversation rather than crashing, the only
# symptom is that the tutor stops knowing the topic.
RAILS_API_URL=http://localhost:8000

# Must match AGENT_SERVICE_TOKEN in ai-speaking-api/.env
AGENT_SERVICE_TOKEN=dev_agent_service_token

# Adaptive interruption is a LiveKit CLOUD service (agent-gateway.livekit.cloud),
# not a local model — it bills per use and 401s against a self-hosted server,
# which kills the job with "failed to detect interruption after 3 attempts".
# Leave unset for self-hosted; set to true only on LiveKit Cloud.
# ADAPTIVE_INTERRUPTION=false

# Voice pipeline
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
ELEVEN_API_KEY=
